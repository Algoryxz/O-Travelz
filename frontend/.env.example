# =========================================================================
# O-Travelz Frontend Client Environment Configuration Template
# Copy this file to .env or .env.production to configure client builds.
# IMPORTANT: All VITE_* variables are PUBLIC and bundled into client JS.
# NEVER put private API secrets, database passwords, or private keys here.
# =========================================================================

# [OPTIONAL] Base URL of the O-Travelz backend API
# If empty or omitted, client uses same-origin relative paths (e.g. /places, /itinerary, /ai)
# which works seamlessly with reverse proxies (Nginx / Vercel / Cloudflare).
# In separate cross-domain deployment (e.g. frontend on S3/Vercel, backend on EC2):
# VITE_API_URL=https://api.otravelz.in
VITE_API_URL=

# [OPTIONAL] Public Application Environment ("development" | "production")
VITE_APP_ENV=development
