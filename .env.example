# =========================================================================
# O-Travelz Environment Configuration Template (Production)
# Copy this file to .env and configure for your deployment environment.
# IMPORTANT: Never commit actual credentials, API keys, or private secrets.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# -------------------------------------------------------------------------
# [REQUIRED] Application environment ("development" | "production")
# Production enforces fail-closed validation on AUTH_SESSION_SECRET & CORS
ENVIRONMENT=development

# [REQUIRED] PostgreSQL with PostGIS database URL
# Local Docker uses port 5433; production PostgreSQL typically uses 5432.
DATABASE_URL=postgresql://otravelz:otravelz@127.0.0.1:5433/otravelz

# [REQUIRED IN PROD] Allowed origins for CORS (comma-separated).
# In development, "*" allows all origins (credentials disabled).
# In production, specify explicit origins (e.g. "https://o-travelz.onrender.com,https://otravelz.in,https://www.otravelz.in").
CORS_ORIGINS=*

# -------------------------------------------------------------------------
# 2. APPLICATION SESSION & COOKIE SECURITY
# -------------------------------------------------------------------------
# [REQUIRED IN PROD] HMAC-SHA256 signing secret (Must be >= 32 high-entropy characters)
AUTH_SESSION_SECRET=otravelz-dev-insecure-secret-key-change-in-prod

# [OPTIONAL] Session cookie name and lifespan
AUTH_SESSION_COOKIE_NAME=otravelz_session
AUTH_SESSION_EXPIRE_DAYS=30
AUTH_OAUTH_STATE_COOKIE_NAME=otravelz_oauth_state
AUTH_OAUTH_STATE_EXPIRE_SECONDS=600

# [REQUIRED IN PROD] Enforce HTTPS Secure flag on cookies
AUTH_COOKIE_SECURE=false

# [OPTIONAL] SameSite cookie policy ("lax" | "strict" | "none"). Use "lax" for local dev, "none" for cross-origin production (requires AUTH_COOKIE_SECURE=true)
AUTH_COOKIE_SAMESITE=lax

# [REQUIRED IN PROD] Frontend SPA destination URL after OAuth login
AUTH_FRONTEND_REDIRECT_URL=http://localhost:5173

# -------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 & OPENID CONNECT (Optional Feature)
# -------------------------------------------------------------------------
# Enable/disable Google login
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -------------------------------------------------------------------------
# 4. IMAGE STORAGE CONFIGURATION
# -------------------------------------------------------------------------
# Options: "local" (default filesystem) | "azure" (Azure Blob Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_BASE_PATH=./data/images

# Azure Blob Storage Configuration (Used only when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=otravelz-images
AZURE_STORAGE_CDN_BASE_URL=

# -------------------------------------------------------------------------
# 5. ZERO-COST AI PROVIDER CONFIGURATION (Optional Feature)
# -------------------------------------------------------------------------
# Provider selection:
#   "mock"             : Deterministic offline simulator (test default)
#   "rule_based"       : Deterministic Whole-Odisha rule engine (100% offline, ₹0)
#   "azure_openai"     : Microsoft Azure OpenAI Service (Free credits)
#   "gemini"           : Google AI Studio Gemini API (Free tier)
#   "nvidia"           : NVIDIA API Catalog (Free build credits)
#   "openai_compatible": Generic OpenAI-compatible HTTP inference endpoint
#   "multi_provider"   : Automated zero-cost fallback chain (Azure -> Gemini -> NVIDIA -> Rule-based)
AI_PROVIDER=mock
AI_ALLOW_EXTERNAL_PROVIDER=false
AI_ALLOW_PAID_PROVIDER=false
AI_FALLBACK_PROVIDER=rule_based
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_REQUEST_LATENCY_BUDGET_MS=8000
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Azure OpenAI (Primary)
AI_API_BASE_URL=
AI_API_KEY=
AI_AZURE_DEPLOYMENT_NAME=gpt-5-mini
AI_AZURE_API_VERSION=2024-12-01-preview

# Google Gemini (Secondary)
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL_NAME=gemini-1.5-flash
AI_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA API (Tertiary)
AI_NVIDIA_API_KEY=
AI_NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct
AI_NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq AI (Ultra-fast LLM & Multimodal Vision)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generic / Fallback model name
AI_MODEL_NAME=

# -------------------------------------------------------------------------
# 6. RATE LIMITING & SYNC BOUNDS
# -------------------------------------------------------------------------
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_EXTERNAL_RATE_LIMIT_REQUESTS=10
AI_EXTERNAL_RATE_LIMIT_WINDOW_SECONDS=60
SYNC_MAX_PLACES_BATCH=100
SYNC_MAX_TRIPS_BATCH=50
SYNC_MAX_TRIP_PAYLOAD_BYTES=51200
SHARE_RATE_LIMIT_REQUESTS=20
SHARE_RATE_LIMIT_WINDOW_SECONDS=3600
SHARE_MAX_PAYLOAD_BYTES=51200

# -------------------------------------------------------------------------
# 7. WEATHER SERVICE CONFIGURATION (Free & Keyless Open-Meteo)
# -------------------------------------------------------------------------
WEATHER_PROVIDER=Open-Meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0
