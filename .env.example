# =========================================================================
# O-Travelz Environment Configuration Template (Production Readiness Audit)
# Copy this file to .env and configure for your local or production environment.
# Never commit real credentials or .env files to source control.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# -------------------------------------------------------------------------
# [REQUIRED] "production" or "development" (Enforces fail-closed secret validation in production)
ENVIRONMENT=development

# [REQUIRED] PostgreSQL with PostGIS connection URL
# Local Docker uses 5433 by default; production typically uses 5432.
DATABASE_URL=postgresql://otravelz:otravelz@127.0.0.1:5433/otravelz

# [OPTIONAL] Comma-separated list of allowed frontend origins for CORS with credentials.
# In development, "*" allows all origins (credentials disabled).
# In production, set to explicit origins e.g. "https://otravelz.in,https://www.otravelz.in"
CORS_ORIGINS=*

# -------------------------------------------------------------------------
# 2. APPLICATION SESSION & COOKIE SECURITY (Phase 13 / 14)
# -------------------------------------------------------------------------
# [REQUIRED IN PROD] HMAC-SHA256 signing secret (Must be >= 32 high-entropy characters in production)
AUTH_SESSION_SECRET=otravelz-dev-insecure-secret-key-change-in-prod

# [OPTIONAL] Session cookie name and lifetime
AUTH_SESSION_COOKIE_NAME=otravelz_session
AUTH_SESSION_EXPIRE_DAYS=30

# [REQUIRED IN PROD] Set to "true" in production to enforce HTTPS-only Secure cookie flag
AUTH_COOKIE_SECURE=false

# [OPTIONAL] SameSite cookie policy ("lax" recommended for OAuth redirects)
AUTH_COOKIE_SAMESITE=lax

# [REQUIRED IN PROD] Frontend SPA destination after OAuth completion
AUTH_FRONTEND_REDIRECT_URL=http://localhost:5173

# -------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 & OPENID CONNECT (Phase 13)
# -------------------------------------------------------------------------
# [OPTIONAL] Enable Google OAuth 2.0 authentication
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -------------------------------------------------------------------------
# 4. IMAGE STORAGE CONFIGURATION
# -------------------------------------------------------------------------
# Options:
#   "local" (Default): Stores assets on local filesystem at LOCAL_STORAGE_BASE_PATH.
#                      Requires zero cloud credentials or internet connectivity.
#   "azure": Stores assets in Azure Blob Storage container.
STORAGE_BACKEND=local
LOCAL_STORAGE_BASE_PATH=./data/images

# Azure Blob Storage Credentials (Used ONLY when STORAGE_BACKEND=azure)
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=otravelz-images
AZURE_STORAGE_CDN_BASE_URL=

# -------------------------------------------------------------------------
# 5. WEATHER SERVICE CONFIGURATION
# -------------------------------------------------------------------------
WEATHER_PROVIDER=Open-Meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
